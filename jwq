#include <stdio.h>
#define PI 3.14159

int main(void)
{
    int r;
    float v, f;
    char comma = ',';
    char firstStr[] = "The volume is:";
    char *secondStr = "The surface area is:";
    r = 2;
    v = 4.0 * PI * r * r * r / 3.0;
    f = 4.0 * PI * r * r;
    printf("%s%f%c%s%f\n", firstStr, v, comma, secondStr, f);
    return 0;
}
